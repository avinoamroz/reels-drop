 "subs_replace": {},
 "lines": [
  {
   "say": "Seven layers protect Israel.",
   "gap": 0.12
  },
  {
   "say": "Layer one: the sky. Iron Dome stops rockets.",
   "screen": "Layer 1: the *sky.* Iron Dome.",
   "screen_icon": "🛡️"
  },
  {
   "say": "David's Sling, for medium range. Arrow three hits missiles above the atmosphere.",
   "screen": "Arrow 3: intercepts *above* the atmosphere"
  },
  {
   "say": "And in December twenty twenty five, the army received its first laser: Iron Beam.",
   "screen": "*Dec 2025:* first Iron Beam laser handed over",
   "screen_icon": "🔦"
  },
  {
   "say": "Layer two: the sea. Four new warships guard the gas fields.",
   "screen": "Layer 2: *4* warships guard the gas fields",
   "screen_icon": "⚓"
  },
  {
   "say": "Layer three: the land. Fences on the borders. But October seventh proved a fence alone is not enough.",
   "screen": "Layer 3: *land.* A fence alone is not enough.",
   "screen_icon": "🧱"
  },
  {
   "say": "Layer four, the one you never see: intelligence. The Mossad abroad, the Shin Bet at home, and the army's Unit eighty two hundred.",
   "screen": "Layer 4: Mossad, Shin Bet, *Unit 8200*",
   "screen_icon": "👁️"
  },
  {
   "say": "In twenty twenty four, the Shin Bet says it foiled over a thousand major attacks.",
   "screen": "*1,040* major attacks foiled in 2024"
  },
  {
   "say": "Layer five: cyber, guarded by the Israel National Cyber Directorate.",
   "screen": "Layer 5: *cyber*",
   "screen_icon": "💻"
  },
  {
   "say": "Layer six: the home front. Red Alerts on every phone, and safe rooms in new homes since the nineties.",
   "screen": "Layer 6: alerts on phones, *safe rooms* at home",
   "screen_icon": "📱"
  },
  {
   "say": "No shield is perfect. On October seventh, the first layers broke.",
   "screen": "No shield is *perfect.*"
  },
  {
   "say": "Within days, three hundred sixty thousand reservists were called up.",
   "screen": "*360,000* reservists called up"
  },
  {
   "say": "And the government they elect decides how the shield is used.",
   "screen": "An *elected* government decides",
   "screen_icon": "🏛️"
  },
  {
   "say": "Layer seven: the people.",
   "screen": "Layer 7: the *people*",
   "screen_icon": "🇮🇱",
   "gap": 0.12
  },
  {
   "say": "Not one wall."
  }
 ],
