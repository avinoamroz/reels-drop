 "lines": [
  {
   "say": "Every country has a Tel Aviv.",
   "gap": 0.12
  },
  {
   "say": "And a Jerusalem. One city runs the country. The other one has the fun.",
   "screen": "One *runs* it. One has the *fun.*",
   "at": "L1:one",
   "gap": 0.12
  },
  {
   "say": "Israel: Jerusalem, seat of the Knesset and the government. Tel Aviv: beaches and startups. Fifty-five kilometers apart.",
   "screen": "Jerusalem and Tel Aviv: *55 km*",
   "at": "L2:fifty",
   "gap": 0.12
  },
  {
   "say": "Turkey: Ankara runs it. Istanbul gets the tourists.",
   "screen": "Ankara and Istanbul",
   "gap": 0.12
  },
  {
   "say": "Morocco: Rabat is the capital. Casablanca is the business hub.",
   "screen": "Rabat and Casablanca",
   "gap": 0.12
  },
  {
   "say": "Saudi Arabia: Riyadh rules. Jeddah is the city by the sea.",
   "screen": "Riyadh and Jeddah",
   "gap": 0.12
  },
  {
   "say": "America: Washington and New York. Australia: Canberra and Sydney. Switzerland: Bern and Zurich.",
   "gap": 0.12
  },
  {
   "say": "Notice something? Washington, Canberra, Ankara: all picked to be capitals.",
   "screen": "Picked to be capitals: *1790, 1908, 1923*",
   "at": "L7:washington",
   "gap": 0.12
  },
  {
   "say": "Jerusalem was a capital three thousand years ago. Tel Aviv was founded in 1909.",
   "screen": "Jerusalem: a capital *3,000* years ago",
   "at": "L8",
   "gap": 0.12
  },
  {
   "say": "Egypt went the other way. In 2024 it moved its government out of Cairo, to a brand new city in the desert.",
   "screen": "Egypt: a *new* capital, since 2024",
   "at": "L9:in",
   "gap": 0.12
  },
  {
   "say": "So how far apart are the two cities?",
   "gap": 0.12
  },
  {
   "say": "Israel: fifty-five kilometers. Only Egypt's brand new capital is closer.",
   "gap": 0.12
  },
  {
   "say": "Israelis say: Jerusalem prays, Haifa works, Tel Aviv plays.",
   "screen": "Jerusalem *prays.* Haifa *works.* Tel Aviv *plays.*",
   "gap": 0.12
  },
  {
   "say": "If you love Israeli facts, follow Noam Roz for more.",
   "wav": "ref/follow_line_noam.wav",
   "gap": 0.12
  },
  {
   "say": "So, where's your country's Tel Aviv?",
   "gap": 0.1
  }
 ],
