  {
   "say": "Where did Europe's Jews go?",
   "gap": 0.15
  },
  {
   "say": "1933. Nine and a half million Jews live in Europe.",
   "screen": "*1933:* 9.5 million Jews in Europe"
  },
  {
   "say": "Every dot is ten thousand people.",
   "screen": "1 dot = *10,000* people"
  },
  {
   "say": "Poland, three million. The Soviet Union, two and a half. Then Romania, Germany, Hungary.",
   "screen": "Poland *3M.* Soviet Union *2.5M.*"
  },
  {
   "say": "Tailors, students, rabbis, grandparents. Whole streets.",
   "screen": "Tailors. Students. Rabbis. *Whole streets.*"
  },
  {
   "say": "Then the Nazis take power. Then the war.",
   "screen": "Then the *Nazis.* Then the war."
  },
  {
   "say": "Now watch the dots.",
   "gap": 0.5
  },
  {
   "say": "1950. Three and a half million.",
   "screen": "*1950:* 3.5 million"
  },
  {
   "say": "Poland: from three million, to forty five thousand.",
   "screen": "Poland: *3,000,000* to *45,000*"
  },
  {
   "say": "Greece, Czechoslovakia, Yugoslavia: over nine in ten, gone.",
   "screen": "Greece, Czechoslovakia, Yugoslavia: *9 in 10* gone"
  },
  {
   "say": "Some survived and left. About one hundred thirty six thousand rebuilt their lives in Israel.",
   "screen": "*136,000* survivors to Israel"
  },
  {
   "say": "Over eighty thousand in the United States.",
   "screen": "*80,000+* to the United States"
  },
  {
   "say": "If you love Israeli facts, follow Noam Roz for more.",
   "wav": "ref/follow_line_noam.wav",
   "screen": "Like Israel facts? Follow *@noamroz__*"
  },
  {
   "say": "And the grey dots? They never went anywhere. Six million Jews were murdered in the Holocaust.",
   "screen": "*6,000,000* murdered in the Holocaust"
  }
 ],
