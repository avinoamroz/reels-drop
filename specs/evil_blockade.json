 "lines": [
  {
   "say": "Evil Israel blockades Gaza. Watch.",
   "gap": 0.45
  },
  {
   "say": "Here is the blockade.",
   "gap": 0.35
  },
  {
   "say": "Trucks. More trucks. Even more trucks.",
   "gap": 0.4
  },
  {
   "say": "The ceasefire deal: six hundred aid trucks a day.",
   "gap": 0.35,
   "screen": "Ceasefire deal, Oct 2025",
   "at": "L3",
   "until": "L4-0.1"
  },
  {
   "say": "By June: one point seven eight million tons of food.",
   "gap": 0.4,
   "screen": "Food into Gaza, Oct to Jun",
   "at": "L4",
   "until": "L5-0.1"
  },
  {
   "say": "How much is that per person?",
   "gap": 0.3
  },
  {
   "say": "About three and a half kilos. Per person. Per day.",
   "gap": 0.5
  },
  {
   "say": "Why? Because HAMAS, their own government, says this.",
   "gap": 0.35,
   "screen": "HAMAS on Gaza's civilians",
   "at": "L7:hamas",
   "until": "L9-0.1"
  },
  {
   "say": "It is the responsibility of the United Nations to protect them.",
   "gap": 0.5
  },
  {
   "say": "So evil Israel paused the fighting. Nine hours a day.",
   "gap": 0.3,
   "screen": "Polio campaign, Sept 2024",
   "at": "L9",
   "until": "L11-0.1"
  },
  {
   "say": "And over half a million kids got polio vaccines.",
   "gap": 0.45
  },
  {
   "say": "Water? A pipe reopened one week into the war.",
   "gap": 0.3,
   "screen": "Water: *15 Oct 2023*",
   "at": "L11",
   "until": "L12-0.05"
  },
  {
   "say": "Power? A line to Gaza's water plant, reconnected.",
   "gap": 0.45,
   "screen": "Power: *Nov 2024*",
   "at": "L12",
   "until": "L13-0.1"
  },
  {
   "say": "Yes. This is how Israel blockades Gaza.",
   "gap": 0.45
  },
  {
   "say": "Oh, and Egypt blockades Gaza too. Rafah, in twenty seventeen? Open thirty-six days.",
   "gap": 0.45,
   "screen": "Rafah, *2017:* open 36 days",
   "at": "L14:rafah",
   "until": "L15-0.1"
  },
  {
   "say": "That is not a blockade. That is sponsorship.",
   "gap": 0.4
  },
  {
   "say": "Many countries would love to be blockaded like this.",
   "gap": 0.4
  },
  {
   "say": "So yes. Evil Israel blockades Gaza."
  }
 ],
