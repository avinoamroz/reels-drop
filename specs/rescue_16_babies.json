  {
   "say": "Sixteen babies, born in a tent.",
   "gap": 0.2
  },
  {
   "say": "Haiti, 2010. An earthquake flattens Port-au-Prince. Israel flies in a field hospital.",
   "screen": "*Haiti, 2010:* a field hospital lands"
  },
  {
   "say": "Before it packs up, it treats 1,102 people, runs 314 surgeries, and delivers those 16 babies.",
   "screen": "*314* surgeries. *16* babies."
  },
  {
   "say": "Japan, 2011. After the tsunami, an Israeli clinic opens in Minamisanriku.",
   "screen": "*Japan, 2011:* Minamisanriku"
  },
  {
   "say": "Its first patient? The town's mayor.",
   "screen": "First patient: *the mayor*"
  },
  {
   "say": "Florida, 2021. A tower collapses in Surfside. An Israeli rescue team flies in to dig beside American crews.",
   "screen": "*Florida, 2021:* Surfside"
  },
  {
   "say": "Turkey, 2023. A huge earthquake. Israeli teams pull 19 people out of the rubble.",
   "screen": "*Turkey, 2023:* 19 saved"
  },
  {
   "say": "In 2016, the World Health Organization ranked Israel's field hospital the first team in the world at its top level.",
   "screen": "*WHO, 2016:* the first top level team"
  },
  {
   "say": "And the very first mission? Greece, 1953. Israel was five years old.",
   "screen": "First mission: *Greece, 1953*"
  },
  {
   "say": "Many countries send rescue teams. Israel is one of them."
  },
  {
   "say": "Should every country keep a team like this? Tell me below.",
   "screen": "Should *every* country have one?"
  },
  {
   "follow": true
  },
  {
   "say": "Remember Haiti?",
   "gap": 0.1
  }
 ],
