 "lines": [
  {"say": "Israel's whole economy, in four boxes."},
  {"say": "The Boston Consulting Group's growth share matrix. Four boxes, one honest map.",
   "screen": "Boston Consulting Group *matrix*", "at": "L1", "until": "L2"},
  {"say": "Stars: growing market, big share. Cyber. Israeli cyber startups raised five point one billion dollars last year.",
   "screen": "Stars: *cyber*", "at": "L2", "until": "L3e"},
  {"say": "Then Google paid thirty two billion dollars for one of them, Wiz."},
  {"say": "Star two, AI. About one in three tech dollars here now goes to AI companies.",
   "screen": "Stars: *AI*", "at": "L4", "until": "L5"},
  {"say": "Cash cows: slow market, big share. Defence. World arms trade barely grew, yet Israel signed a record nineteen point two billion dollars in deals.",
   "screen": "Cash cows: *defence*", "at": "L5", "until": "L6"},
  {"say": "Question marks: growing fast, still small. Gas, with a thirty five billion dollar deal to supply Egypt.",
   "screen": "Question marks: *gas*", "at": "L6", "until": "L7"},
  {"say": "And food tech. Israel gave the world's first approval for cultivated beef.",
   "screen": "Question marks: *food tech*", "at": "L7", "until": "L8"},
  {"say": "Dogs: slow market, shrinking share. Polished diamonds, down from about seven billion dollars a year to under two.",
   "screen": "Dogs: *polished diamonds*", "at": "L8", "until": "L9"},
  {"say": "The catch? High tech is fifty eight percent of exports. That's a lot of eggs in one basket."},
  {"say": "So which box would you bet on next?"}
 ],
