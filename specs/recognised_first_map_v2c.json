   "say": "Who recognised Israel first?",
   "gap": 0.15
  },
  {
   "say": "May fourteenth, nineteen forty eight. Israel declares independence.",
   "screen": "*14 May 1948:* independence"
  },
  {
   "say": "By the end of that year, seventeen countries.",
   "screen": "End of 1948: *17* countries"
  },
  {
   "say": "By nineteen fifty, forty seven.",
   "screen": "*1950:* 47"
  },
  {
   "say": "In the sixties, dozens of newly independent African states.",
   "screen": "1960s: newly independent *African* states"
  },
  {
   "say": "Nineteen seventy nine. Egypt, the first Arab country.",
   "screen": "*1979:* Egypt, the first Arab country"
  },
  {
   "say": "Then the Soviet Union falls. Forty more in the nineties, including China and Jordan.",
   "screen": "1990s: *40* more, incl. China and Jordan"
  },
  {
   "say": "Twenty twenty. The UAE, Bahrain, Morocco and Bhutan.",
   "screen": "*2020:* UAE, Bahrain, Morocco, Bhutan"
  },
  {
   "say": "Today, one hundred sixty nine of the other one hundred ninety two United Nations members.",
   "screen": "Today: *169* of 192 United Nations members"
  },
  {
   "say": "Twenty three still say no. Twenty two are Muslim majority countries. The other is North Korea.",
   "screen": "*23* still say no"
  },
  {
   "say": "Recognising is not agreeing. Many of them criticise Israel too.",
   "screen": "Recognising is *not* agreeing"
  },
  {
   "say": "The Soviet Union gave the first full legal recognition, three days later.",
   "screen": "17 May 1948: Soviet Union, *first legal* recognition"
  },
  {
   "say": "If you like Israel facts, follow <<n|oʊ|ˈ|ɑ|m>> <<ˈ|r|ɑː|z>> for more.",
   "screen": "Like Israel facts? Follow *@noamroz__*"
  },
  {
   "say": "But the very first? The United States. Eleven minutes after.",
   "screen": "First: the *United States,* 11 minutes after"
  }
 ],
