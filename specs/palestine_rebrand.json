 "lines": [
  {
   "say": "Nineteen thirty-two: the Palestine Post, a Jewish newspaper.",
   "gap": 0.3
  },
  {
   "say": "Watch the word Palestinian change owners.",
   "gap": 0.15
  },
  {
   "say": "Nineteen oh two: the Anglo-Palestine Bank, founded by Zionists.",
   "gap": 0.12
  },
  {
   "say": "Under the British, Jews and Arabs were Palestinian citizens.",
   "gap": 0.12
  },
  {
   "say": "Thirty-four: Palestine's World Cup team, every player Jewish.",
   "gap": 0.12
  },
  {
   "say": "Thirty-six: the Palestine Orchestra, Jewish musicians.",
   "gap": 0.15
  },
  {
   "say": "Arabs used the name too: the Jaffa paper Filastin.",
   "gap": 0.2
  },
  {
   "say": "Nineteen forty-eight, Israel is born. Rebrand time.",
   "gap": 0.12
  },
  {
   "say": "The Palestine Post becomes The Jerusalem Post.",
   "gap": 0.12
  },
  {
   "say": "The orchestra: Israel Philharmonic. The bank: Bank Leumi. The team: Israel.",
   "gap": 0.12
  },
  {
   "say": "Palestinian now means the Arabs of the land.",
   "gap": 0.25
  },
  {
   "say": "The flag? Older than you think.",
   "gap": 0.12
  },
  {
   "say": "Nineteen sixteen, the Arab Revolt flag.",
   "gap": 0.12
  },
  {
   "say": "Forty-eight, Gaza's All-Palestine Government adopts it.",
   "gap": 0.12
  },
  {
   "say": "Sixty-four, the PLO, the Palestine Liberation Organization, takes it.",
   "gap": 0.12
  },
  {
   "say": "Jordan's flag? Almost identical, plus a star.",
   "gap": 0.15
  },
  {
   "say": "First leader? Not Arafat, but Ahmad Shukeiri.",
   "gap": 0.2
  },
  {
   "say": "Every nation is born sometime: Jordan forty-six, Israel forty-eight.",
   "gap": 0.15
  },
  {
   "say": "Today millions call themselves Palestinian, and that's real.",
   "gap": 0.15
  },
  {
   "say": "The name has a surprising history. It started with a newspaper.",
   "gap": 0.0
  }
 ],
