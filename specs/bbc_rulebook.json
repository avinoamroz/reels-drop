   "gap": 0.12
  },
  {
   "say": "Al Shifa raid. BBC: the army is targeting medical teams.",
   "gap": 0.12
  },
  {
   "say": "Not true. The army brought medics. BBC apologised.",
   "gap": 0.12
  },
  {
   "say": "White House: <<h|ɑ|ˈ|m|ɑ|s>> used Al Shifa as a command and control node.",
   "gap": 0.2
  },
  {
   "say": "The BBC does issue corrections. Judge it by the record.",
   "gap": 0.15
  },
  {
   "say": "Send this to someone who still trusts rule five.",
   "gap": 0.1
