 "lines": [
  {
   "say": "Forty one years, two peace deals. Then four in four months.",
   "gap": 0.2
  },
  {
   "say": "1979: Egypt. The first Arab country to make peace with Israel.",
   "screen": "*1979:* Egypt"
  },
  {
   "say": "1994: Jordan.",
   "screen": "*1994:* Jordan"
  },
  {
   "say": "Then, for twenty six years, nothing.",
   "screen": "*26* years: nothing"
  },
  {
   "say": "August 2020: the United Arab Emirates.",
   "screen": "*Aug 2020:* the UAE"
  },
  {
   "say": "September: Bahrain.",
   "screen": "*Sep:* Bahrain"
  },
  {
   "say": "October: Sudan. December: Morocco.",
   "screen": "*Oct:* Sudan. *Dec:* Morocco."
  },
  {
   "say": "They're called the Abraham Accords.",
   "screen": "The *Abraham* Accords"
  },
  {
   "say": "Within weeks, the first direct flight from Israel lands in Abu Dhabi.",
   "screen": "*31 Aug 2020:* first flight to Abu Dhabi"
  },
  {
   "say": "In 2025, Kazakhstan said it would join too.",
   "screen": "*2025:* Kazakhstan joins"
  },
  {
   "say": "Not all of it held. Sudan's deal is still not ratified, and Palestinian leaders called it a stab in the back.",
   "screen": "Sudan: *not ratified*"
  },
  {
   "say": "Who joins next? Tell me below.",
   "screen": "Who joins *next?*"
  },
  {
   "follow": true
  },
  {
   "say": "Peace, by the numbers.",
   "gap": 0.1
  }
 ],
