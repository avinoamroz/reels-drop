  {
   "say": "Level one: Spanish, French, Italian, Dutch. About six hundred hours."
  },
  {
   "say": "Level two: German. Seven hundred and fifty hours."
  },
  {
   "say": "Level three: Indonesian, Malay, Swahili. Nine hundred hours."
  },
  {
   "say": "Level five, the hardest: Arabic, Mandarin, Japanese, Korean. Twenty two hundred hours.",
   "gap": 0.4
  },
  {
   "say": "And Hebrew? Level four. Eleven hundred hours."
