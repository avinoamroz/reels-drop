 "lines": [
  {
   "say": "Who recognised Israel first?",
   "gap": 0.15
  },
  {
   "say": "May fourteenth, 1948. In Tel Aviv, Israel's leaders sign the Declaration of Independence.",
   "screen": "*14 May 1948:* the Declaration"
  },
  {
   "say": "At midnight in Tel Aviv, six in the evening in Washington, the new state is born.",
   "screen": "Washington: *6:00 PM*"
  },
  {
   "say": "Eleven minutes later, President Truman recognises it.",
   "screen": "*11 minutes* later: Truman"
  },
  {
   "say": "The United States is first. In practice, not yet in law.",
   "screen": "First: the *United States*"
  },
  {
   "say": "Three days later, the Soviet Union gives the first full legal recognition.",
   "screen": "*17 May:* Soviet Union, first in law"
  },
  {
   "say": "Then the clock speeds up."
  },
  {
   "say": "By the end of 1948, seventeen countries. By 1950, forty seven."
  },
  {
   "say": "1979: Egypt, the first Arab country.",
   "screen": "*1979:* Egypt, the first Arab country"
  },
  {
   "say": "The nineties: forty more, including China and Jordan.",
   "screen": "1990s: *40* more, incl. China and Jordan"
  },
  {
   "say": "2020: the UAE, Bahrain and Morocco.",
   "screen": "*2020:* UAE, Bahrain, Morocco"
  },
  {
   "say": "Today: one hundred sixty nine of the other one hundred ninety two United Nations members.",
   "screen": "Today: *169* of 192 UN members"
  },
  {
   "say": "Recognising isn't agreeing. Many of them still criticise Israel.",
   "screen": "Recognising is *not* agreeing"
  },
  {
   "say": "If you love Israeli facts, follow Noam Roz for more.",
   "wav": "ref/follow_line_noam.wav",
   "screen": "Like Israel facts? Follow *@noamroz__*"
  },
  {
   "say": "The first took eleven minutes. Twenty three still haven't, seventy eight years later.",
   "screen": "First: *11 minutes.* *23* still waiting."
  }
 ],
