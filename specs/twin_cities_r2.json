 "lines": [
  {
   "say": "Fifty five kilometres. From praying to partying.",
   "gap": 0.12
  },
  {
   "say": "Many countries have two cities. One runs it, one has the fun. How far apart are they?",
   "screen": "One *runs* it. One has the *fun.*",
   "at": "L1:one",
   "gap": 0.12,
   "until": "L2-0.1"
  },
  {
   "say": "Saudi Arabia: Riyadh rules, Jeddah has the sea. Eight hundred forty five kilometres.",
   "gap": 0.12
  },
  {
   "say": "Turkey: Ankara runs it, Istanbul gets the tourists. Three hundred forty nine.",
   "gap": 0.12
  },
  {
   "say": "Washington and New York, three hundred twenty eight. Canberra and Sydney, two hundred forty seven.",
   "gap": 0.12
  },
  {
   "say": "Bern and Zurich, ninety five. Rabat and Casablanca, eighty five.",
   "gap": 0.12
  },
  {
   "say": "Washington, Canberra, Ankara: all picked to be capitals.",
   "screen": "Picked to be capitals: *1790, 1908, 1923*",
   "at": "L6:washington",
   "gap": 0.12,
   "until": "L7-0.1"
  },
  {
   "say": "Jerusalem was a capital three thousand years ago. Tel Aviv was founded on the sand in nineteen oh nine.",
   "screen": "Jerusalem: a capital *3,000* years ago",
   "at": "L7",
   "gap": 0.12,
   "until": "L8-0.1"
  },
  {
   "say": "Fifty five kilometres apart. The closest pair so far.",
   "gap": 0.12
  },
  {
   "say": "Only Egypt is closer. In twenty twenty four it moved its government to a brand new city, fifty kilometres from Cairo.",
   "screen": "Egypt: a *new* capital, since 2024",
   "at": "L9:in",
   "gap": 0.12,
   "until": "L10-0.1"
  },
  {
   "say": "So Israelis say: Jerusalem prays, Tel Aviv plays.",
   "screen": "Jerusalem *prays.* Tel Aviv *plays.*",
   "gap": 0.12
  },
  {
   "say": "Where's your country's Tel Aviv?",
   "gap": 0.12
  },
  {
   "say": "If you love Israeli facts, follow Noam Roz for more.",
   "wav": "ref/follow_line_tts.wav",
   "gap": 0.12
  },
  {
   "say": "And the drive between them?",
   "gap": 0.1
  }
 ],
