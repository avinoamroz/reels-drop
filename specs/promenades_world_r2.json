  {
   "say": "Fourteen kilometres of seafront. Who beats Tel Aviv?",
   "gap": 0.2
  },
  {
   "say": "Its promenade runs from Jaffa to the north. Thirteen beaches, one walk.",
   "screen": "Tel Aviv: *14 km,* 13 beaches",
   "at": "L1",
   "until": "L1e"
  },
  {
   "say": "Let's race the world's famous seafronts. Shortest first.",
   "screen": "Seafronts by *length*",
   "at": "L2",
   "until": "L2e"
  },
  {
   "say": "Venice Beach, three kilometres. Copacabana, four."
  },
  {
   "say": "Beirut, almost five. Bondi to Coogee, six."
  },
  {
   "say": "Nice and Doha, about seven each."
  },
  {
   "say": "Tel Aviv, fourteen. Double everyone so far."
  },
  {
   "say": "And busy: eight and a half million beach visits a year. Only Venice Beach claims more."
  },
  {
   "say": "So is Tel Aviv the champion? Not quite. One seafront is longer."
  },
  {
   "say": "Alexandria's Corniche, in Egypt. Over sixteen kilometres."
  },
  {
   "say": "Tel Aviv takes silver. Not bad for a city of half a million."
  },
  {
   "say": "Which one would you walk?",
   "screen": "Which one would *you* walk?",
   "at": "L11",
   "until": "L12"
  },
  {
   "say": "If you love Israeli facts, follow Noam Roz for more.",
   "wav": "ref/follow_line_noam.wav",
   "screen": "Like Israel facts? Follow *@noamroz__*",
   "at": "L12",
   "until": "L13"
  },
  {
   "say": "Fourteen kilometres. And still not the longest."
  }
 ],
