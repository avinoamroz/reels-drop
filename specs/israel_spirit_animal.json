 "lines": [
  {
   "say": "Five countries as animals. Not by vibes. By data.",
   "gap": 0.2
  },
  {
   "say": "The Netherlands: a beaver.",
   "screen": "The *Netherlands*",
   "at": "L1",
   "until": "L3"
  },
  {
   "say": "Twenty six percent of the country is below sea level. So they build dams. Professionally."
  },
  {
   "say": "Switzerland: an ibex.",
   "screen": "*Switzerland*",
   "at": "L3",
   "until": "L6"
  },
  {
   "say": "In eighteen oh nine, the last Swiss ibex was shot. In nineteen oh six, Switzerland smuggled some back from Italy."
  },
  {
   "say": "Today, about seventeen thousand. Very organised."
  },
  {
   "say": "Japan: a tortoise.",
   "screen": "*Japan*",
   "at": "L6",
   "until": "L8"
  },
  {
   "say": "Over one hundred seven thousand people aged one hundred or more."
  },
  {
   "say": "The Emirates: a falcon.",
   "screen": "The *UAE*",
   "at": "L8",
   "until": "L10"
  },
  {
   "say": "Literally. Falcons there get passports. Over twenty eight thousand of them."
  },
  {
   "say": "And Israel?",
   "screen": "And *Israel?*",
   "at": "L10",
   "until": "L15"
  },
  {
   "say": "A hedgehog."
  },
  {
   "say": "Small: about point zero one five percent of the world's land."
  },
  {
   "say": "Spiky: Iron Dome stopped about ninety percent of the rockets aimed at its cities."
  },
  {
   "say": "And somehow, still cuddly. The eighth happiest country on Earth."
  },
  {
   "say": "Which animal is your country?",
   "screen": "Which animal is *your* country?",
   "at": "L15",
   "until": "L16"
  },
  {
   "say": "If you love Israeli facts, follow Noam Roz for more.",
   "wav": "ref/follow_line_noam.wav",
   "screen": "Like Israel facts? Follow *@noamroz__*",
   "at": "L16",
   "until": "L17"
  },
  {
   "say": "Five countries as animals. By data."
  }
 ],
