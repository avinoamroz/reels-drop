 "lines": [
  {
   "say": "The Golan Heights: 100 years in 60 seconds."
  },
  {
   "say": "1923. Britain and France draw a line. The Golan goes to Syria."
  },
  {
   "say": "1949. The armistice leaves Syria on the heights, above the Sea of Galilee."
  },
  {
   "say": "Both sides clash, and Syrian guns shell the farms below."
  },
  {
   "say": "1965. Syria starts diverting the Jordan's sources. Israel strikes the works."
  },
  {
   "say": "June 1967. In two days, Israel takes the Golan."
  },
  {
   "say": "1973. On Yom Kippur, Syria attacks. Israel holds, then pushes back."
  },
  {
   "say": "1974. A Kissinger deal returns Quneitra to Syria. United Nations peacekeepers move in."
  },
  {
   "say": "1981. Israel applies its law there. The UN Security Council: null and void."
  },
  {
   "say": "2000. Talks with Syria collapse over the Sea of Galilee shore."
  },
  {
   "say": "2019. America recognises Israeli sovereignty. Most of the world does not."
  },
  {
   "say": "December 2024. Assad falls, and Israeli troops enter the buffer zone."
  },
  {
   "say": "Syria says occupied land. Israel says security frontier. Who's right?"
  },
  {
   "follow": true,
   "until": "L14"
  },
  {
   "say": "It all began with one line, drawn in 1923."
  }
 ],
