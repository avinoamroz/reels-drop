 "lines": [
  {
   "say": "Thirty three votes. Did they make a country?",
   "gap": 0.2
  },
  {
   "say": "November 29, 1947. The U.N. votes on splitting British ruled Palestine in two.",
   "screen": "*29 Nov 1947:* the UN votes"
  },
  {
   "say": "One Jewish state. One Arab state. And Jerusalem, under the U.N.",
   "screen": "*2* states. Jerusalem: *international*"
  },
  {
   "say": "Thirty three countries vote yes. Even the United States and the Soviet Union agree.",
   "screen": "*33* yes: the US *and* the USSR"
  },
  {
   "say": "Thirteen vote no. Among them, every Arab member state.",
   "screen": "*13* no: all *6* Arab members"
  },
  {
   "say": "Ten abstain. Britain, the ruling power, is one of them.",
   "screen": "*10* abstain, Britain too"
  },
  {
   "say": "Jewish leaders accept the plan. Arab leaders reject it.",
   "screen": "Jewish leaders: *yes.* Arab leaders: *no.*"
  },
  {
   "say": "Violence starts almost at once. Six months later, full war.",
   "screen": "Then: *war*"
  },
  {
   "say": "That war cost both peoples dearly. Hundreds of thousands of Palestinian Arabs became refugees.",
   "screen": "Both peoples paid a *price*"
  },
  {
   "say": "Was partition the right call? Tell me below.",
   "screen": "Partition: *the right call?*"
  },
  {
   "follow": true
  },
  {
   "say": "And it all came down to thirty three votes.",
   "gap": 0.1
  }
 ],
