 "lines": [
  {
   "say": "193 countries today. Guess where Israel ranks by age.",
   "gap": 0.15
  },
  {
   "say": "Each one lights up the year it became fully sovereign.",
   "screen": "Lit when *fully sovereign*",
   "gap": 0.12
  },
  {
   "say": "The oldest dates go back more than a thousand years. Japan, Denmark, France.",
   "gap": 0.12
  },
  {
   "say": "1776, the United States. Then Latin America breaks away from Spain.",
   "gap": 0.12
  },
  {
   "say": "By 1900, only 52 of today's countries exist.",
   "screen": "1900: only *52*",
   "at": "L4:52",
   "gap": 0.12
  },
  {
   "say": "Two world wars later, the map starts moving fast.",
   "gap": 0.12
  },
  {
   "say": "May 1948. Israel.",
   "gap": 0.15
  },
  {
   "say": "Israel is country number 81. 112 of today's countries didn't exist yet.",
   "gap": 0.12
  },
  {
   "say": "1960: seventeen new countries in Africa, in one year.",
   "screen": "1960: *17* in Africa alone",
   "at": "L8:seventeen",
   "gap": 0.12
  },
  {
   "say": "Kuwait, 1961. Qatar, Bahrain and the UAE, 1971.",
   "screen": "Gulf states: *1961* to *1971*",
   "gap": 0.12
  },
  {
   "say": "1991: the Soviet Union and Yugoslavia break apart.",
   "screen": "1991: *14* new countries",
   "gap": 0.12
  },
  {
   "say": "And South Sudan, 2011. The youngest.",
   "screen": "*2011:* the youngest",
   "gap": 0.12
  },
  {
   "say": "Some dates are debated, and age doesn't make a country better.",
   "screen": "*193* countries, one clock",
   "gap": 0.12
  },
  {
   "say": "But Israel is older than 112 of the world's 193 countries.",
   "gap": 0.15
  },
  {
   "say": "If you love Israeli facts, follow Noam Roz for more.",
   "wav": "ref/follow_line_noam.wav",
   "gap": 0.12
  },
  {
   "say": "Now guess again. 193 countries.",
   "gap": 0.1
  }
 ],
