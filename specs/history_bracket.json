 "lines": [
  {
   "say": "Three thousand year tournament. Who's still standing?",
   "gap": 0.2
  },
  {
   "say": "Two rivals per match. Winner moves up.",
   "gap": 0.15
  },
  {
   "say": "Match one: Egypt versus Israel. By tradition, Pharaoh's army almost catches them. They escape.",
   "gap": 0.15
  },
  {
   "say": "Then Pharaoh Merneptah carves a result in stone: Israel is laid waste, his seed is not.",
   "gap": 0.2
  },
  {
   "say": "Match two: Assyria beats the Kingdom of Israel. Sargon boasts of over twenty-seven thousand captives.",
   "gap": 0.15
  },
  {
   "say": "Then Babylon and the Medes knock out Assyria. Nineveh falls.",
   "gap": 0.15
  },
  {
   "say": "Babylon beats Judah. The First Temple burns. Exile.",
   "gap": 0.15
  },
  {
   "say": "Comeback: Persia beats Babylon, and Cyrus lets the exiles go home.",
   "gap": 0.15
  },
  {
   "say": "Alexander's Greeks beat Persia.",
   "gap": 0.15
  },
  {
   "say": "Upset of the tournament: the Hasmoneans beat the Seleucid Greeks. That's Hanukkah.",
   "gap": 0.15
  },
  {
   "say": "Then Rome burns the Second Temple, crushes Bar Kokhba, and bans Jews from Jerusalem.",
   "gap": 0.2
  },
  {
   "say": "The Assyrian Empire, gone. Babylon's, gone. Persia's, gone. The Seleucids, gone. Western Rome, gone.",
   "gap": 0.2
  },
  {
   "say": "The empires fell. Their peoples moved on.",
   "gap": 0.2
  },
  {
   "say": "The team that lost almost every match? Nineteen forty-eight. Same land, same language, same city.",
   "gap": 0.2
  },
  {
   "say": "Mark Twain: All things are mortal but the Jew; all other forces pass, but he remains.",
   "gap": 0.2
  },
  {
   "say": "The tournament is still on. Who's still standing?",
   "gap": 0.1
  }
 ],
