{
 "id": "conquest_waves",
 "account": "noamroz__",
 "template": "map_counter",
 "hook": "*11* empires invaded.|Who *stayed?*",
 "music": {
  "bed": "doc_piano",
  "lufs": -16,
  "bed_lufs": -26,
  "duck_db": 14
 },
 "voice": {
  "tempo": 1.12,
  "gap": 0.12
 },
 "lines": [
  {
   "say": "Eleven empires invaded this small land. Watch who stayed.",
   "gap": 0.15
  },
  {
   "say": "722 BCE. Assyria conquers the northern kingdom and deports its people.",
   "screen": "Sargon II's own records: *27,290* deported",
   "at": "L1:deports",
   "gap": 0.12
  },
  {
   "say": "586 BCE. Babylon destroys Jerusalem and its Temple, and exiles Judah.",
   "screen": "*Babylon* burns the Temple",
   "gap": 0.12
  },
  {
   "say": "539 BCE. Persia lets the exiles go home and rebuild.",
   "screen": "*Persia* lets them rebuild",
   "gap": 0.12
  },
  {
   "say": "332, Alexander. 63 BCE, Rome.",
   "screen": "*Alexander,* then *Rome*",
   "gap": 0.12
  },
  {
   "say": "In 70 CE, Rome burns the Second Temple.",
   "screen": "*70 CE:* Temple burned",
   "gap": 0.12
  },
  {
   "say": "In 135, it crushes the last revolt and renames the land.",
   "screen": "Judea becomes *Syria Palaestina*",
   "at": "L6:renames",
   "gap": 0.12
  },
  {
   "say": "Byzantium. The caliphate in 636. Crusaders in 1099. Mamluks in 1260.",
   "screen": "Empire after *empire*",
   "gap": 0.12
  },
  {
   "say": "In 1488, a visiting rabbi counts seventy Jewish families in Jerusalem.",
   "screen": "Still *here*",
   "at": "L8:seventy",
   "gap": 0.12
  },
  {
   "say": "1516, the Ottomans. Their own tax records count about seven thousand Jews.",
   "screen": "*Ottoman* tax registers",
   "at": "L9:tax",
   "gap": 0.12
  },
  {
   "say": "By the 1880s, fifteen to twenty four thousand.",
   "gap": 0.12
  },
  {
   "say": "1917, Britain. Its own census: about 84,000 Jews in 1922. 175,000 in 1931.",
   "screen": "*British* census of Palestine",
   "at": "L11:census",
   "gap": 0.12
  },
  {
   "say": "1948. Independence.",
   "screen": "*1948:* independence",
   "gap": 0.12
  },
  {
   "say": "Today, about 7.3 million.",
   "screen": "*Today*",
   "gap": 0.15
  },
  {
   "say": "Many peoples lived here too, and their history is real.",
   "gap": 0.12
  },
  {
   "say": "Every empire left. The Jewish people never did.",
   "screen": "Every empire *left.*",
   "gap": 0.15
  },
  {
   "say": "If you love Israeli facts, follow Noam Roz for more.",
   "wav": "ref/follow_line_noam.wav",
   "gap": 0.12
  },
  {
   "say": "So count them again. Eleven empires.",
   "gap": 0.1
  }
 ],
