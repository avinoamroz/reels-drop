  {
   "say": "The United States: two."
  },
  {
   "say": "Iran, North Korea, Myanmar: one each."
  },
  {
   "say": "Sudan, the world's largest displacement crisis: zero."
  },
  {
   "say": "And Israel: fifteen. More than the rest of the world combined.",
   "gap": 0.5
  },
  {
   "say": "Now let's make it fair. Per ten million people.",
   "screen": "Per *10 million* people",
   "at": "L7:per"
  },
  {
   "say": "Russia: under half a condemnation. Israel: almost fifteen."
  },
  {
   "say": "That's over a thousand times the rest of the world.",
   "gap": 0.5
  },
  {
   "say": "Israel's war in Gaza deserves scrutiny, like any war."
  },
  {
   "say": "But fifteen to eleven isn't scrutiny. It's a pattern.",
   "gap": 0.45
  },
  {
   "say": "So next time someone quotes the U.N., remember:"
  }
 ],
