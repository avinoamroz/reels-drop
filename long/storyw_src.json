{"name": "storyw_src", "dur": 73.8, "video": "", "lang": "he", "segs": [{"s": 2.74, "e": 3.86, "t": "תודה שהתקשר.", "w": [["תודה", 2.74, 3.34], ["שהתקשר.", 3.34, 3.86]]}, {"s": 33.56, "e": 34.46, "t": "אה, מה עולה?", "w": [["אה,", 33.56, 34.12], ["מה", 34.14, 34.2], ["עולה?", 34.2, 34.46]]}, {"s": 34.6, "e": 35.1, "t": "אני לא יודע.", "w": [["אני", 34.6, 34.84], ["לא", 34.84, 35.08], ["יודע.", 35.08, 35.1]]}, {"s": 37.62, "e": 39.04, "t": "ראשי ניסה משהו, נראה לי", "w": [["ראשי", 37.62, 38.18], ["ניסה", 38.18, 38.44], ["משהו,", 38.44, 38.64], ["נראה", 38.74, 38.96], ["לי", 38.96, 39.04]]}, {"s": 39.04, "e": 40.46, "t": "מה קורה וזה.", "w": [["מה", 39.04, 39.38], ["קורה", 39.38, 40.08], ["וזה.", 40.08, 40.46]]}, {"s": 40.66, "e": 42.02, "t": "כמו דיברנו, זה הכל.", "w": [["כמו", 40.66, 40.92], ["דיברנו,", 40.92, 41.5], ["זה", 41.58, 41.66], ["הכל.", 41.66, 42.02]]}, {"s": 42.64, "e": 43.46, "t": "אה, הכל משהו?", "w": [["אה,", 42.64, 42.82], ["הכל", 42.88, 43.2], ["משהו?", 43.2, 43.46]]}, {"s": 43.76, "e": 45.18, "t": "אה, אופי, שמחה לשמוע.", "w": [["אה,", 43.76, 44.06], ["אופי,", 44.2, 44.56], ["שמחה", 44.58, 44.86], ["לשמוע.", 44.86, 45.18]]}, {"s": 45.78, "e": 48.04, "t": "אם אתה צריך משהו, אתה תמיד מולן", "w": [["אם", 45.78, 46.34], ["אתה", 46.34, 46.52], ["צריך", 46.52, 46.8], ["משהו,", 46.8, 47.18], ["אתה", 47.24, 47.34], ["תמיד", 47.34, 47.6], ["מולן", 47.6, 48.04]]}, {"s": 48.04, "e": 49.34, "t": "תהיה לדבר בזה.", "w": [["תהיה", 48.04, 48.6], ["לדבר", 48.6, 49.04], ["בזה.", 49.04, 49.34]]}, {"s": 50.02, "e": 50.92, "t": "שלום עולה מי יש?", "w": [["שלום", 50.02, 50.36], ["עולה", 50.36, 50.48], ["מי", 50.48, 50.68], ["יש?", 50.68, 50.92]]}, {"s": 51.58, "e": 53.46, "t": "זה פחות, אנחנו משוקים.", "w": [["זה", 51.58, 52.14], ["פחות,", 52.14, 52.62], ["אנחנו", 52.62, 52.96], ["משוקים.", 52.96, 53.46]]}, {"s": 53.64, "e": 54.92, "t": "זה לא המחלקה שלכם?", "w": [["זה", 53.64, 53.64], ["לא", 53.64, 53.76], ["המחלקה", 53.76, 54.52], ["שלכם?", 54.52, 54.92]]}, {"s": 55.0